#!/bin/sh
# Container PID 1. Polls until the PostClaim init command publishes a complete
# connection file, then replaces itself with codex exec-server. The executor
# is not restarted here; process exit is the sandbox exit.
set -eu

file=${OPENAI_CONNECTION_FILE:-/workspace/.openai-env/connection}

while [ ! -s "$file" ]; do
	sleep 1
done

environment_id=
remote_url=
while IFS= read -r line || [ -n "$line" ]; do
	case "$line" in
	environment_id=*)
		environment_id=${line#environment_id=}
		;;
	remote_url=*)
		remote_url=${line#remote_url=}
		;;
	esac
done <"$file"

if [ -z "$environment_id" ] || [ -z "$remote_url" ]; then
	echo "connection file is missing environment_id or remote_url" >&2
	exit 1
fi
if [ -z "${CODEX_API_KEY:-}" ]; then
	echo "CODEX_API_KEY is required in the sandbox environment" >&2
	exit 1
fi

if [ -d /workspace ]; then
	cd /workspace
fi

exec codex exec-server --remote "$remote_url" --environment-id "$environment_id"
