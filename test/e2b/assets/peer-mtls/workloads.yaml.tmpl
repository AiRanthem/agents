# CI fixtures for the latest peer mTLS E2E row. Not production configuration.
apiVersion: v1
kind: ConfigMap
metadata:
  name: peer-mtls-fixture
  namespace: sandbox-system
  labels:
    app.kubernetes.io/part-of: peer-mtls-e2e
data:
  nonce: "PLACEHOLDER_NONCE"
  echo-a-body: "PLACEHOLDER_ECHO_A"
  echo-b-body: "PLACEHOLDER_ECHO_B"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: peer-mtls-echo-a
  namespace: sandbox-system
  labels:
    app.kubernetes.io/part-of: peer-mtls-e2e
    app.kubernetes.io/name: peer-mtls-echo
    app.kubernetes.io/component: echo-a
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/component: echo-a
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: peer-mtls-e2e
        app.kubernetes.io/name: peer-mtls-echo
        app.kubernetes.io/component: echo-a
    spec:
      containers:
        - name: helper
          image: peer-mtls-helper:latest
          imagePullPolicy: IfNotPresent
          args: ["-mode=echo"]
          env:
            - name: RESPONSE_BODY
              valueFrom:
                configMapKeyRef:
                  name: peer-mtls-fixture
                  key: echo-a-body
          ports:
            - containerPort: 18080
              name: echo
          resources:
            requests:
              cpu: 25m
              memory: 32Mi
            limits:
              cpu: 100m
              memory: 64Mi
          readinessProbe:
            tcpSocket:
              port: echo
            periodSeconds: 2
---
