apiVersion: apps/v1
kind: Deployment
metadata:
  name: peer-mtls-witness
  namespace: sandbox-system
  labels:
    app.kubernetes.io/part-of: peer-mtls-e2e
    app.kubernetes.io/name: peer-mtls-witness
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: peer-mtls-witness
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: peer-mtls-e2e
        app.kubernetes.io/name: peer-mtls-witness
        component: sandbox-manager
    spec:
      serviceAccountName: peer-mtls-helper
      containers:
        - name: helper
          image: peer-mtls-helper:latest
          imagePullPolicy: IfNotPresent
          args: ["-mode=witness"]
          env:
            - name: POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: HOSTNAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: PEER_NAMESPACE
              value: sandbox-system
            - name: PEER_LABEL_SELECTOR
              value: component=sandbox-manager
            - name: PEER_TLS_SERVER_SECRET
              value: sandbox-system/peer-mtls-server
            - name: PEER_TLS_CLIENT_SECRET
              value: sandbox-system/peer-mtls-helper-client
            - name: EXPLICIT_UNTRUSTED_CERT
              value: /certs/untrusted/client.crt
            - name: EXPLICIT_UNTRUSTED_KEY
              value: /certs/untrusted/client.key
            - name: EXPLICIT_SERVER_AS_CLIENT_CERT
              value: /certs/server-as-client/tls.crt
            - name: EXPLICIT_SERVER_AS_CLIENT_KEY
              value: /certs/server-as-client/tls.key
            - name: EXPLICIT_SERVER_CA
              value: /certs/ca/ca.crt
          ports:
            - containerPort: 7789
              name: peer
            - containerPort: 7946
              name: memberlist
            - containerPort: 18081
              name: admin
            - containerPort: 18082
              name: probe
          volumeMounts:
            - name: untrusted
              mountPath: /certs/untrusted
              readOnly: true
            - name: server-as-client
              mountPath: /certs/server-as-client
              readOnly: true
            - name: trusted-ca
              mountPath: /certs/ca
              readOnly: true
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
          readinessProbe:
            tcpSocket:
              port: admin
            periodSeconds: 2
      volumes:
        - name: untrusted
          secret:
            secretName: peer-mtls-untrusted-client
        - name: server-as-client
          secret:
            secretName: peer-mtls-server
        - name: trusted-ca
          secret:
            secretName: peer-mtls-server
            items:
              - key: ca.crt
                path: ca.crt
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: peer-mtls-wrong-ca
  namespace: sandbox-system
  labels:
    app.kubernetes.io/part-of: peer-mtls-e2e
    app.kubernetes.io/name: peer-mtls-negative
    app.kubernetes.io/component: wrong-ca
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/component: wrong-ca
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: peer-mtls-e2e
        app.kubernetes.io/name: peer-mtls-negative
        app.kubernetes.io/component: wrong-ca
    spec:
      containers:
        - name: helper
          image: peer-mtls-helper:latest
          imagePullPolicy: IfNotPresent
          args: ["-mode=tls-refresh"]
          env:
            - name: TLS_CERT_FILE
              value: /certs/tls.crt
            - name: TLS_KEY_FILE
              value: /certs/tls.key
            - name: TLS_CA_FILE
              value: /certs/ca.crt
          ports:
            - containerPort: 7789
              name: peer
            - containerPort: 18081
              name: admin
            - containerPort: 18082
              name: probe
          volumeMounts:
            - name: tls
              mountPath: /certs
              readOnly: true
          resources:
            requests:
              cpu: 25m
              memory: 32Mi
            limits:
              cpu: 100m
              memory: 64Mi
          readinessProbe:
            tcpSocket:
              port: admin
            periodSeconds: 2
      volumes:
        - name: tls
          secret:
            secretName: peer-mtls-untrusted-server
