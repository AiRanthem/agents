--- a/.p10k.zsh
+++ b/.p10k.zsh
@@ -379,6 +379,9 @@
       local   modified='%178F'  # yellow foreground
       local  untracked='%39F'   # blue foreground
       local conflicted='%196F'  # red foreground
+      if [[ ${ITERM_PROFILE-} == '莫兰迪配色' ]]; then
+        clean='%2F' modified='%3F' untracked='%4F' conflicted='%1F'
+      fi
     else
       # Styling for incomplete and stale Git status.
       local       meta='%244F'  # grey foreground
@@ -1707,6 +1710,19 @@
   # really need it.
   typeset -g POWERLEVEL9K_DISABLE_HOT_RELOAD=true

+  # Use the 莫兰迪配色 palette directly for the prompt's main colors.
+  if [[ ${ITERM_PROFILE-} == '莫兰迪配色' ]]; then
+    typeset -g POWERLEVEL9K_DIR_FOREGROUND=4
+    typeset -g POWERLEVEL9K_DIR_SHORTENED_FOREGROUND=4
+    typeset -g POWERLEVEL9K_DIR_ANCHOR_FOREGROUND=3
+    typeset -g POWERLEVEL9K_VCS_{CLEAN_FOREGROUND,VISUAL_IDENTIFIER_COLOR}=2
+    typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND=4
+    typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND=3
+    typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND=2
+    typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND=1
+    typeset -g POWERLEVEL9K_TIME_FOREGROUND=6
+  fi
+
   # If p10k is already loaded, reload configuration.
   # This works even with POWERLEVEL9K_DISABLE_HOT_RELOAD=true.
   (( ! $+functions[p10k] )) || p10k reload
